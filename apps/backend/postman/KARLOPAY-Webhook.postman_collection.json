					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"numberOfOrder\": null,\n  \"invalidField\": \"test\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/payments/karlopay/webhook/payment",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"payments",
						"karlopay",
						"webhook",
						"payment"
					]
				},
				"description": "Prueba de validación: envía un payload inválido (sin `numberOfOrder` requerido). Debería retornar 400 Bad Request."
			},
			"response": []
		},
		{
			"name": "8. Webhook - Orden No Encontrada",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Respuesta exitosa (aunque no haya orden)\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response).to.have.property('success');",
							"});",
							"",
							"console.log(\"ℹ️ El webhook retorna 200 aunque no encuentre la orden (solo loguea warning)\");"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"numberOfOrder\": \"ORDER_NOT_FOUND_12345\",\n  \"paymentInformation\": {\n    \"originalAmount\": 1000,\n    \"totalPayment\": 1000\n  }\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/payments/karlopay/webhook/payment",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"payments",
						"karlopay",
						"webhook",
						"payment"
					]
				},
				"description": "Prueba con un `numberOfOrder` que no existe en la base de datos. El webhook retornará 200 OK pero registrará un warning en los logs de integración."
			},
			"response": []
		}
	],
