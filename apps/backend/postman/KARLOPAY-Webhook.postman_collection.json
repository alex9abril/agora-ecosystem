							"pm.test(\"Status code es 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Respuesta exitosa\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response).to.have.property('success');",
							"    pm.expect(response.success).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"numberOfOrder\": \"TEST123\",\n  \"paymentInformation\": {\n    \"originalAmount\": 10000,\n    \"totalPayment\": 10000\n  }\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/payments/karlopay/webhook/payment",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"payments",
						"karlopay",
						"webhook",
						"payment"
					]
				},
				"description": "Ejemplo mínimo del webhook con solo los campos requeridos. Útil para pruebas rápidas."
			},
			"response": []
		},
		{
			"name": "3. Webhook - Con Información Fiscal Completa",
			"event": [
				{
					"listen": "test",
