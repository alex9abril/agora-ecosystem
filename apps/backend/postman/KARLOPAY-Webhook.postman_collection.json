				},
				"description": "Ejemplo de pago con promoción activa (`promotion: true`)."
			},
			"response": []
		},
		{
			"name": "5. Webhook - Error: IP No Autorizada",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 401\", function () {",
							"    pm.response.to.have.status(401);",
							"});",
							"",
							"pm.test(\"Mensaje de error apropiado\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response.message).to.include('IP');",
							"});",
							"",
							"console.log(\"⚠️ Este error es esperado si KARLOPAY_WEBHOOK_ALLOWED_IPS está configurado\");"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Forwarded-For",
						"value": "192.168.1.100",
						"type": "text",
						"description": "IP no autorizada para probar el guard de seguridad"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"numberOfOrder\": \"UNAUTHORIZED_IP\",\n  \"paymentInformation\": {\n    \"originalAmount\": 1000,\n    \"totalPayment\": 1000\n  }\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/payments/karlopay/webhook/payment",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"payments",
						"karlopay",
						"webhook",
						"payment"
					]
				},
				"description": "Prueba del guard de seguridad: intenta acceder con una IP no autorizada. Este request debería fallar con 401 si `KARLOPAY_WEBHOOK_ALLOWED_IPS` está configurado y no incluye esta IP.\n\n**Nota:** Si `KARLOPAY_WEBHOOK_ALLOWED_IPS` está vacío o no configurado, este request funcionará normalmente."
			},
			"response": []
		},
		{
			"name": "6. Webhook - Error: Firma Inválida",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 401\", function () {",
							"    pm.response.to.have.status(401);",
							"});",
							"",
							"pm.test(\"Mensaje de error apropiado\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response.message).to.include('firma');",
							"});",
							"",
							"console.log(\"⚠️ Este error es esperado si KARLOPAY_WEBHOOK_SECRET está configurado\");"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Karlopay-Signature",
						"value": "firma_invalida_12345",
						"type": "text",
						"description": "Firma inválida para probar la validación"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"numberOfOrder\": \"INVALID_SIGNATURE\",\n  \"paymentInformation\": {\n    \"originalAmount\": 1000,\n    \"totalPayment\": 1000\n  }\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/payments/karlopay/webhook/payment",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"payments",
						"karlopay",
						"webhook",
						"payment"
					]
				},
				"description": "Prueba del guard de seguridad: intenta acceder con una firma inválida. Este request debería fallar con 401 si `KARLOPAY_WEBHOOK_SECRET` está configurado.\n\n**Nota:** Si `KARLOPAY_WEBHOOK_SECRET` está vacío o no configurado, este request funcionará normalmente (sin validar firma)."
			},
			"response": []
		},
		{
			"name": "7. Webhook - Error: Payload Inválido",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 400\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"console.log(\"⚠️ Error de validación esperado\");"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
