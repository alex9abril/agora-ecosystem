						"exec": [
							"pm.test(\"Status code es 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Respuesta exitosa\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response).to.have.property('success');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"numberOfOrder\": \"FISCAL001\",\n  \"cardType\": \"CREDIT VISA\",\n  \"paymentDate\": \"2026-02-27T14:30:00\",\n  \"cardDC\": \"visa\",\n  \"bankName\": \"BBVA\",\n  \"bankCode\": \"012\",\n  \"referenceNumber\": \"123456789\",\n  \"cardHolder\": \"JUAN PEREZ\",\n  \"postalCode\": \"01234\",\n  \"meses\": 0,\n  \"paymentMethod\": \"PUE\",\n  \"paymentForm\": \"03\",\n  \"promotion\": false,\n  \"taxData\": {\n    \"socialReason\": \"EMPRESA SA DE CV\",\n    \"postalCodeTax\": \"01234\",\n    \"RFC\": \"ABC123456DEF\",\n    \"taxRegime\": \"601\",\n    \"CFDI\": \"G01\",\n    \"email\": \"facturacion@empresa.com\"\n  },\n  \"paymentInformation\": {\n    \"percentageBaseComission\": 0.025,\n    \"percentageBaseSurcharge\": 0,\n    \"commissions\": {\n      \"baseComission\": 250.00,\n      \"baseComissionIva\": 40.00,\n      \"baseComissionTotal\": 290.00\n    },\n    \"surcharges\": {\n      \"baseSurcharge\": 0,\n      \"baseSurchargeIva\": 0,\n      \"baseSurchargeTotal\": 0\n    },\n    \"originalAmount\": 10000,\n    \"totalCommissionForTerminalUse\": 0,\n    \"totalCommissionForDeferringToMonths\": 0,\n    \"totalCommissionToCustomer\": 0,\n    \"totalCommissionToBusiness\": 290.00,\n    \"totalToDepositBusiness\": 9710.00,\n    \"totalPaymentPerMonth\": 10000,\n    \"totalPayment\": 10000\n  },\n  \"additional\": {\n    \"session_id\": \"FISCAL001\",\n    \"order_group_id\": \"00000000-0000-0000-0000-000000000002\"\n  }\n}"
				},
