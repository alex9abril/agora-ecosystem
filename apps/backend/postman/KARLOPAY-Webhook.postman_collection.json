		},
		{
			"key": "karlopay_ip",
			"value": "192.168.1.1",
			"type": "string",
			"description": "IP de KarloPay para testing (solo si KARLOPAY_WEBHOOK_ALLOWED_IPS está configurado)"
		},
		{
			"key": "webhook_signature",
			"value": "",
			"type": "string",
			"description": "Firma del webhook (HMAC SHA256). Solo necesario si KARLOPAY_WEBHOOK_SECRET está configurado."
		}
	],
