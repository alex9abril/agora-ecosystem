					]
				},
				"description": "Ejemplo con información fiscal completa (RFC, régimen fiscal, CFDI). Útil para probar el guardado de datos fiscales en `payment_data.taxData`."
			},
			"response": []
		},
		{
			"name": "4. Webhook - Pago con Promoción",
			"request": {
				"method": "POST",
				"header": [
