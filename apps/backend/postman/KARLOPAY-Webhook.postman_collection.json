						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"numberOfOrder\": \"PROMO001\",\n  \"cardType\": \"CREDIT AMEX\",\n  \"paymentDate\": \"2026-02-27T15:00:00\",\n  \"cardDC\": \"amex\",\n  \"bankName\": \"n/a\",\n  \"bankCode\": \"999\",\n  \"postalCode\": \"12345\",\n  \"meses\": 0,\n  \"paymentMethod\": \"PUE\",\n  \"paymentForm\": \"04\",\n  \"promotion\": true,\n  \"paymentInformation\": {\n    \"originalAmount\": 5000,\n    \"totalPayment\": 5000,\n    \"totalToDepositBusiness\": 5000\n  },\n  \"additional\": {\n    \"session_id\": \"PROMO001\"\n  }\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/payments/karlopay/webhook/payment",
