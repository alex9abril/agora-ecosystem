    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst url = j.checkout_url || '';\nconst t = (j.message_type || 'default').toString();\n\nconst templates = {\n  default:\n    'Para continuar tu compra en el sitio, entra aquí:\\n' +\n    url +\n    '\\n\\nSi el enlace expira, escríbenos y te mandamos uno nuevo.',\n  abandoned:\n    'Seguimos guardando tu carrito. Puedes terminar tu compra aquí:\\n' +\n    url +\n    '\\n\\n¿Necesitas ayuda para elegir?',\n  review:\n    'Revisa tu pedido y datos antes de pagar:\\n' +\n    url +\n    '\\n\\nCualquier duda, estamos aquí.',\n  human_handoff:\n    'Tu enlace para comprar en el sitio:\\n' +\n    url +\n    '\\n\\nUn asesor también puede ayudarte si lo prefieres.',\n};\n\nconst whatsapp_body = templates[t] || templates.default;\nreturn [{ json: { ...j, whatsapp_body } }];\n"
      },
