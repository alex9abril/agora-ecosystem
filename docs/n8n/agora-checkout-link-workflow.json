    {
      "parameters": {
        "jsCode": "const http = $input.first().json;\nconst waOk =\n  (http.statusCode ?? 200) >= 200 && (http.statusCode ?? 200) < 300;\nconst prev = $('Code: mensaje éxito por message_type').first().json;\nreturn [\n  {\n    json: {\n      ok: true,\n      step: 'checkout_link_sent',\n      integration_cart_id: prev.integration_cart_id,\n      contact_phone: prev.contact_phone,\n      conversation_id: prev.conversation_id,\n      checkout_url: prev.checkout_url,\n      whatsapp_delivered: waOk,\n      wa_status: http.statusCode,\n    },\n  },\n];\n"
      },
