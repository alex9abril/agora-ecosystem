      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst msg =\n  'No pude generar tu enlace: faltan datos del carrito o el teléfono no es válido. Escríbenos \"asesor\" y te atiende una persona.';\nreturn [{ json: { ...j, whatsapp_body: msg } }];\n"
      },
