      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst base =\n  'Hubo un problema al crear tu enlace de compra. ' +\n  (j.api_message ? `(${j.api_message}) ` : '') +\n  'Te comunicamos con un asesor en un momento.';\nreturn [{ json: { ...j, whatsapp_body: base } }];\n"
